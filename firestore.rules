rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone can read the published content (app + website)
    match /{document=**} {
      allow read: if true;
    }
    // Only the admin account can write
    function isAdmin() {
      return request.auth != null && request.auth.uid == "Yvb0sMKuR0NqFcbSK25NpGPkgST2";
    }
    match /places/{id}   { allow write: if isAdmin(); }
    match /photos/{id}   { allow write: if isAdmin(); }
    match /videos/{id}   { allow write: if isAdmin(); }
    match /pages/{id}    { allow write: if isAdmin(); }
    match /settings/{id} { allow write: if isAdmin(); }
  }
}
