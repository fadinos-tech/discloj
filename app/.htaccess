# Discover the Land of Jesus — static site under /discloj/
AddType application/manifest+json .webmanifest
AddType video/mp4 .mp4
AddType text/javascript .js .mjs
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(js|css|html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <Files "sw.js">
    Header set Service-Worker-Allowed "/discloj/"
  </Files>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json
</IfModule>
Options -Indexes
